<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题头部 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三星相机 GPS 水印助手"
            android:textColor="#1A1C1E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="拍照后自动提取 EXIF GPS 解析中文具体地址并叠加水印"
            android:textColor="#5A5F67"
            android:textSize="13sp" />

        <!-- 服务开关卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动水印监听"
                    android:textColor="#1F2328"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="状态：未运行"
                android:textColor="#0969DA"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 水印生成间隔选项卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 水印生成间隔 (节省手机存储)"
                android:textColor="#1F2328"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="打上水印后启动定时器，计时结束前跳过新照片，避免连续拍照导致相册容量翻倍："
                android:textColor="#5A5F67"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rg_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_interval_always"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="1 - 常开 (每张照片均加水印，默认)"
                    android:textColor="#1F2328"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_interval_1m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="2 - 一分钟 (生成一张后暂停 1 分钟)"
                    android:textColor="#1F2328"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_interval_2m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="3 - 两分钟 (生成一张后暂停 2 分钟)"
                    android:textColor="#1F2328"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_interval_5m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="4 - 五分钟 (生成一张后暂停 5 分钟)"
                    android:textColor="#1F2328"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_interval_10m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="5 - 十分钟 (生成一张后暂停 10 分钟)"
                    android:textColor="#1F2328"
                    android:textSize="14sp" />
            </RadioGroup>

        </LinearLayout>

        <!-- 水印内容与机型配置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ 水印内容与机型设置"
                android:textColor="#1F2328"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="排版：第一行（时间 + 机型），第二行（详细中文地址）"
                android:textColor="#5A5F67"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="自定义机型名称 (显示在第一行)："
                android:textColor="#1F2328"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_device_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#EFEFEF"
                android:padding="10dp"
                android:hint="例如：三星 Z fold8"
                android:textSize="14sp"
                android:textColor="#1F2328"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="高德 Web 服务 Key (选填，解锁超精细航站楼/小区/园区)："
                android:textColor="#1F2328"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_amap_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#EFEFEF"
                android:padding="10dp"
                android:hint="留空默认使用 OSM+系统引擎优先解析建筑地标"
                android:textSize="13sp"
                android:textColor="#1F2328"
                android:singleLine="true" />

        </LinearLayout>

        <!-- 权限与说明卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 使用前提与权限"
                android:textColor="#1F2328"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_location_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="正在检查权限状态..."
                android:textColor="#42474E"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_grant_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0969DA"
                android:text="授予必要权限 (相册与定位)"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="💡 提示：在三星原生相机设置中，必须打开【位置标签】开关，拍摄的照片才会自带经纬度元数据。"
                android:textColor="#8C9199"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 测试与效果演示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 效果测试"
                android:textColor="#1F2328"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pick_photo_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1F883D"
                android:text="从相册挑选一张照片测试打水印"
                android:textColor="#FFFFFF" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_result_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="选择照片后，将在此显示提取的时间与逆编码地点"
                android:textColor="#42474E"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/img_preview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:background="#E1E4E8"
                android:scaleType="centerInside" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
